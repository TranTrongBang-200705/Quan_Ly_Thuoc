# Copy file này thành .env rồi sửa lại theo máy của cậu.

# Ví dụ SQL Server Windows Authentication:
# DATABASE_URL=mssql+pyodbc://@localhost/DataThuoc?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# Ví dụ SQL Server Express instance SQLEXPRESS dùng Windows Authentication:
DATABASE_URL=mssql+pyodbc:///?odbc_connect=DRIVER%3DODBC+Driver+17+for+SQL+Server%3BSERVER%3DLALISAMANOBAN%5CSQLEXPRESS02%3BDATABASE%3DDataThuoc%3BTrusted_Connection%3Dyes%3BTrustServerCertificate%3Dyes%3BEncrypt%3Dno%3B

# Ví dụ SQL Auth:
# DATABASE_URL=mssql+pyodbc://sa:YourPassword@localhost/DataThuoc?driver=ODBC+Driver+17+for+SQL+Server

JWT_SECRET_KEY=CHANGE_THIS_SECRET_FOR_DEVELOPMENT_ONLY
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
AI_SERVICE_BASE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
