# Copy file này thành .env rồi sửa lại theo máy của cậu.

# Ví dụ SQL Server Windows Authentication:
# DATABASE_URL=mssql+pyodbc://@localhost/DataThuoc?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&Encrypt=no

# Ví dụ SQL Server Express instance SQLEXPRESS dùng Windows Authentication:
DATABASE_URL=mssql+pyodbc://@localhost\SQLEXPRESS/DataThuoc?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&Encrypt=no

# Ví dụ SQL Auth:
# DATABASE_URL=mssql+pyodbc://sa:YourPassword@localhost/DataThuoc?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=no

JWT_SECRET_KEY=CHANGE_THIS_SECRET_FOR_DEVELOPMENT_ONLY
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
AI_SERVICE_BASE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
